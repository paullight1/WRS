# WRS live environment contract
# Copy these names into the target hosting environment. Never commit real values.
# Staging and production must use separate Supabase projects, provider keys and internal secrets.

# Client runtime authority
VITE_WRS_MODE=staging
VITE_WRS_AUTHORITY_URL=https://wrs-staging.example.invalid
VITE_WRS_PAYMENT_SERVICE=true
VITE_WRS_IDENTITY_SERVICE=true
VITE_WRS_ROBOT_SERVICE=true
VITE_WRS_DATA_SERVICE=true
VITE_WRS_REWARD_SERVICE=true
VITE_WRS_DEPLOYMENT_SERVICE=true
VITE_WRS_SUPPORT_SERVICE=true
VITE_WRS_OAUTH_ENABLED=false

# Supabase authority — use publishable/secret keys from the dedicated WRS project only.
SUPABASE_URL=https://your-wrs-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-wrs-publishable-key
SUPABASE_SECRET_KEY=replace-with-wrs-secret-key

# Payment provider. Staging must use sk_test_; production must use sk_live_.
PAYSTACK_SECRET_KEY=sk_test_replace_with_wrs_sandbox_key
# PAYSTACK_BASE_URL=https://api.paystack.co

# Private storage
WRS_DATA_BUCKET=wrs-private-data

# Internal integrations / workers — generate separate random values per environment.
WRS_DATA_SCANNER_SECRET=replace-with-at-least-32-random-characters
WRS_DATA_REVIEW_SECRET=replace-with-at-least-32-random-characters
WRS_DATA_DELETION_SECRET=replace-with-at-least-32-random-characters
WRS_DEPLOYMENT_OPERATIONS_SECRET=replace-with-at-least-32-random-characters
WRS_ECOSYSTEM_OPERATOR_TOKEN=replace-with-at-least-32-random-characters
WRS_ACADEMY_ASSESSOR_TOKEN=replace-with-at-least-32-random-characters
WRS_COMMUNITY_OPERATOR_TOKEN=replace-with-at-least-32-random-characters
WRS_REFERRAL_QUALIFIER_TOKEN=replace-with-at-least-32-random-characters
WRS_ACCOUNT_DELETION_WORKER_TOKEN=replace-with-at-least-32-random-characters
